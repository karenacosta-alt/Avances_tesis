# Copiar a /etc/estacion/estacion.env y completar. No subir el archivo real al repositorio.
CODIGO_ESTACION=EST0X
URL_SERVIDOR=http://IP_DEL_SERVIDOR:8000/api/lecturas
INTERVALO_MIN=15
MAX_ENVIOS_POR_CICLO=200

DB_NAME=estacion_db
DB_USER=estacion_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

PORT_CO2=/dev/ttyAMA3
PORT_PM=/dev/ttyAMA5
I2C_BUS=1
I2C_ADDR_SEN0466=0x74
I2C_ADDR_BME680=0x77
